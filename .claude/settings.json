{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run check)",
      "Bash(npm run check:all)",
      "Bash(npm run build:web)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run dev:login *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test *)",
      "Bash(npx prettier *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "ask": ["Bash(npm run db:dev:reset)", "Bash(supabase migration *)", "Bash(git push *)", "Bash(gh pr merge *)"],
    "deny": [
      "Bash(supabase db reset --linked *)",
      "Bash(supabase db push *)",
      "Bash(supabase link *)",
      "Bash(supabase projects delete *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git push origin main)",
      "Bash(git reset --hard *)",
      "Read(./.env)",
      "Read(./.env.dev)",
      "Read(./apps/web/.env.local)",
      "Read(./apps/mobile/.env)",
      "Read(./apps/mobile/.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-migrations.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck-on-stop.mjs\"",
            "timeout": 180,
            "statusMessage": "Typechecking changed code…"
          }
        ]
      }
    ]
  }
}
