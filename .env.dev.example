# Dev Supabase project (dtour-dev). Copy to .env.dev and fill in — never point this at production.
# Dashboard → Project Settings → API keys / Database → Connection string (session pooler).
DEV_SUPABASE_URL=https://<dev-project-ref>.supabase.co
DEV_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
DEV_SUPABASE_SECRET_KEY=sb_secret_...
DEV_DB_URL=postgresql://postgres.<dev-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
