EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Error monitoring (optional; Sentry stays off while the DSN is empty). The DSN is
# public by design. Use "development" or "production" so dev noise stays apart.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
# Source-map and native-symbol upload runs only if SENTRY_AUTH_TOKEN, SENTRY_ORG and
# SENTRY_PROJECT are set as EAS environment variables. They are secrets: never put them in a file.
